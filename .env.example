# MAGI environment configuration
# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars are exposed to the client.
# Secrets (OpenAI / Honcho / service-role keys) belong on the FastAPI backend.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend that fronts OpenAI + Honcho (e.g. http://localhost:8000)
EXPO_PUBLIC_API_BASE_URL=
